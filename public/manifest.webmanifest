{
  "name": "Ndod Pogo Dex",
  "short_name": "Ndod Pogo Dex",
  "description": "Visual living dex for Pokemon GO screenshots",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#0e1116",
  "background_color": "#0e1116",
  "start_url": "./",
  "scope": "./",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
