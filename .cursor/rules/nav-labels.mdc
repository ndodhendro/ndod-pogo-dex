```tsx
// ❌ BAD
<NavLink to="/dex">Pokédex</NavLink>

// ✅ GOOD
<NavLink to="/dex">
  <span aria-hidden="true">
    <img src={`${import.meta.env.BASE_URL}nav/pokedex.png`} alt="" width={24} height={24} />
  </span>
  Pokédex
</NavLink>
```
